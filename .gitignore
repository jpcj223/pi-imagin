/output/

# 品牌探索过程留在本机，只提交选定原稿。
/design/*
!/design/pi-imagin-logo-ocean-blue-v9.png
!/design/pi-imagin-logo-selected-prototype.png
!/design/pi-imagin-logo-cosmic.png
!/design/pi-imagin-logo-cosmic-ocean.png

# next.js
/.next/
/.desktop-dev/
/out/

# production
/build
/desktop/node_modules/
/dist-desktop/
**/.pi-imagin-trash/

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

